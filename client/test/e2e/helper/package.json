{
  "name": "e2e-helper",
  "publisher": "remotium-test",
  "version": "0.0.0",
  "private": true,
  "engines": { "vscode": "^1.100.0" },
  "extensionKind": ["ui"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "properties": {
        "remotiumE2e.launchLink": { "type": "string", "default": "" },
        "remotiumE2e.resultFile": { "type": "string", "default": "" },
        "remotiumE2e.suite": { "type": "string", "default": "smoke" },
        "remotiumE2e.controlDir": { "type": "string", "default": "" },
        "remotiumE2e.only": { "type": "string", "default": "" }
      }
    }
  }
}

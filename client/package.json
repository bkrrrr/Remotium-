{
  "name": "client",
  "displayName": "Remotium",
  "description": "Open VSCodium on your own machines over HTTPS, through remotium-host.",
  "publisher": "remotium",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "resolvers"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onResolveRemoteAuthority:remotium",
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Remotium",
      "properties": {}
    },
    "commands": [
      {
        "command": "remotium.addHost",
        "title": "Remotium: Add Host\u2026"
      },
      {
        "command": "remotium.openHost",
        "title": "Remotium: Open Host\u2026"
      },
      {
        "command": "remotium.removeHost",
        "title": "Remotium: Remove Host\u2026"
      },
      {
        "command": "remotium.disconnect",
        "title": "Remotium: Disconnect"
      },
      {
        "command": "remotium.showLog",
        "title": "Remotium: Show Log"
      },
      {
        "command": "remotium.menu",
        "title": "Remotium: Connection Menu"
      },
      {
        "command": "remotium.setUp",
        "title": "Remotium: Finish Setup (allow remote connection API)"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-remote",
        "authority": "remotium+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "Remotium"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remotium.menu",
          "when": "remoteName == remotium"
        },
        {
          "command": "remotium.disconnect",
          "when": "remoteName == remotium"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/extension.ts --bundle --main-fields=module,main --platform=node --target=node20 --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --main-fields=module,main --platform=node --target=node20 --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js --sourcemap --watch",
    "package": "npm run build && cp ../LICENSE ../THIRD_PARTY_NOTICES.md . && vsce package --no-dependencies --allow-missing-repository --out remotium-client.vsix",
    "test:e2e": "npm run build && node test/e2e/run-host.js",
    "test:phase3": "npm run build && node test/e2e/run-host.js --suite phase3 --timeout 600000",
    "test:unit": "esbuild test/unit/*.test.ts --bundle --main-fields=module,main --platform=node --outdir=out-test --external:vscode --log-level=warning && node --test out-test/*.test.js",
    "test:e2e:vsix": "npm run package && node test/e2e/first-install.js",
    "test:browser": "node test/e2e/run-browser.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ws": "^8.23.0"
  }
}

{
  "name": "client",
  "displayName": "Remotium",
  "description": "Open-source remote tunnels for VSCodium: connect to a dev container through an Remotium server.",
  "publisher": "remotium",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "resolvers"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onResolveRemoteAuthority:remotium",
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Remotium",
      "properties": {
        "remotium.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Remotium server, e.g. https://tunnels.example.com. Set automatically when a launch link is opened."
        },
        "remotium.directUrl": {
          "type": "string",
          "default": "",
          "description": "Development only: WebSocket URL of an agent started with --direct-listen. Used for the authority remotium+direct and bypasses the server."
        },
        "remotium.directConnectionToken": {
          "type": "string",
          "default": "",
          "description": "Development only: connection token printed by the agent in direct mode."
        }
      }
    },
    "commands": [
      {
        "command": "remotium.openLaunchLink",
        "title": "Remotium: Open Launch Link"
      },
      {
        "command": "remotium.connectDirect",
        "title": "Remotium: Connect Direct (dev)"
      },
      {
        "command": "remotium.disconnect",
        "title": "Remotium: Disconnect"
      },
      {
        "command": "remotium.signOut",
        "title": "Remotium: Sign Out"
      },
      {
        "command": "remotium.showLog",
        "title": "Remotium: Show Log"
      },
      {
        "command": "remotium.menu",
        "title": "Remotium: Connection Menu"
      },
      {
        "command": "remotium.setUp",
        "title": "Remotium: Finish Setup (allow remote connection API)"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-remote",
        "authority": "remotium+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "Remotium"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remotium.menu",
          "when": "remoteName == remotium"
        },
        {
          "command": "remotium.disconnect",
          "when": "remoteName == remotium"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/extension.ts --bundle --main-fields=module,main --platform=node --target=node20 --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --main-fields=module,main --platform=node --target=node20 --format=cjs --external:vscode --external:bufferutil --external:utf-8-validate --outfile=out/extension.js --sourcemap --watch",
    "package": "npm run build && cp ../THIRD_PARTY_NOTICES.md . && vsce package --no-dependencies --allow-missing-repository --out remotium-client.vsix",
    "test:smoke": "node test/e2e/launch.js",
    "test:e2e": "npm run build && node test/e2e/run-server.js",
    "test:phase3": "npm run build && node test/e2e/run-server.js --suite phase3 --on-request test/e2e/compose-action.sh --timeout 900000",
    "test:unit": "esbuild test/unit/*.test.ts --bundle --main-fields=module,main --platform=node --outdir=out-test --external:vscode --log-level=warning && node --test out-test/",
    "test:e2e:vsix": "node test/e2e/first-install.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.100.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ws": "^8.23.0"
  }
}
